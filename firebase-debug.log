[debug] [2026-10-20T11:45:51.114Z] <<< [apiv2][body] POST https://firebaserules.googleapis.com/v1/projects/woste-4dbbe/rulesets {"name":"projects/woste-4dbbe/rulesets/93800775-acab-48dd-9f66-32610a280d02","source":{"files":[{"content":"rules_version = '2';\nservice cloud.firestore {\n  match /databases/{database}/documents {\n    function signedIn() { return request.auth != null; }\n    function isAdmin() {\n      return signedIn()\n        && exists(/databases/$(database)/documents/admins/$(request.auth.uid))\n        && get(/databases/$(database)/documents/admins/$(request.auth.uid)).data.role == 'admin';\n    }\n    function validCouponRedemption(redemptionId, couponId, cost, userId) {\n      let couponBefore = get(/databases/$(database)/documents/coupons/$(couponId)).data;\n      let couponAfter = getAfter(/databases/$(database)/documents/coupons/$(couponId)).data;\n      let userBefore = get(/databases/$(database)/documents/users/$(userId)).data;\n      let userAfter = getAfter(/databases/$(database)/documents/users/$(userId)).data;\n      return couponBefore.status == 'active'\n        && couponBefore.remainingQuantity > 0\n        && couponBefore.pointsCost == cost\n        && couponAfter.remainingQuantity == couponBefore.remainingQuantity - 1\n        && couponAfter.quantity == couponAfter.remainingQuantity\n        && couponAfter.lastRedemptionId == redemptionId\n        && userBefore.points >= cost\n        && userAfter.points == userBefore.points - cost\n        && userAfter.lastCouponRedemptionId == redemptionId;\n    }\n\n    match /admins/{adminId} {\n      allow get: if signedIn() && request.auth.uid == adminId;\n      allow list, create, update, delete: if false;\n    }\n\n    match /users/{userId} {\n      allow read: if signedIn() && (request.auth.uid == userId || isAdmin());\n      allow create: if signedIn()\n        && request.auth.uid == userId\n        && request.resource.data.uid == userId\n        && request.resource.data.bottles == 0\n        && request.resource.data.points == 0\n        && request.resource.data.money == 0\n        && request.resource.data.keys().hasOnly([\n          'uid', 'username', 'email', 'bottles', 'points', 'money', 'createdAt'\n        ]);\n      allow update: if isAdmin()\n        || (signedIn() && request.auth.uid == userId\n          && ((request.resource.data.diff(resource.data).affectedKeys().hasOnly(['university', 'dormType'])\n              && request.resource.data.university is string\n              && request.resource.data.university.size() > 0\n              && ((request.resource.data.university == 'มหาวิทยาลัยธรรมศาสตร์'\n                  && request.resource.data.dormType in ['หอใน', 'หอนอก', 'บ้าน'])\n                || (request.resource.data.university != 'มหาวิทยาลัยธรรมศาสตร์'\n                  && request.resource.data.dormType == null)))\n            || (request.resource.data.diff(resource.data).affectedKeys().hasOnly(['points', 'lastCouponRedemptionId'])\n              && request.resource.data.points is int\n              && request.resource.data.points >= 0\n              && request.resource.data.points < resource.data.points\n              && request.resource.data.lastCouponRedemptionId is string\n              && existsAfter(/databases/$(database)/documents/couponRedemptions/$(request.resource.data.lastCouponRedemptionId))\n              && getAfter(/databases/$(database)/documents/couponRedemptions/$(request.resource.data.lastCouponRedemptionId)).data.userId == userId\n              && getAfter(/databases/$(database)/documents/couponRedemptions/$(request.resource.data.lastCouponRedemptionId)).data.cost == resource.data.points - request.resource.data.points)));\n      allow delete: if isAdmin();\n\n      match /history/{historyId} {\n        allow read: if signedIn() && (request.auth.uid == userId || isAdmin());\n        allow create, update, delete: if isAdmin();\n      }\n      match /couponHistory/{redemptionId} {\n        allow read: if signedIn() && (request.auth.uid == userId || isAdmin());\n        allow create, update, delete: if false;\n      }\n    }\n\n    match /coupons/{couponId} {\n      allow read: if signedIn();\n      allow create: if isAdmin()\n        && request.resource.data.id == couponId\n        && request.resource.data.pointsCost is int && request.resource.data.pointsCost > 0\n        && request.resource.data.totalQuantity is int && request.resource.data.totalQuantity >= 0\n        && request.resource.data.remainingQuantity is int\n        && request.resource.data.remainingQuantity >= 0\n        && request.resource.data.remainingQuantity <= request.resource.data.totalQuantity\n        && request.resource.data.quantity == request.resource.data.remainingQuantity\n        && request.resource.data.status in ['active', 'pending']\n        && request.resource.data.keys().hasOnly(['id', 'name', 'description', 'pointsCost', 'totalQuantity', 'remainingQuantity', 'quantity', 'status', 'icon']);\n      allow update: if (isAdmin()\n          && request.resource.data.diff(resource.data).affectedKeys().hasOnly([\n            'pointsCost', 'totalQuantity', 'remainingQuantity', 'quantity', 'status'\n          ])\n          && request.resource.data.pointsCost is int && request.resource.data.pointsCost > 0\n          && request.resource.data.totalQuantity is int && request.resource.data.totalQuantity >= 0\n          && request.resource.data.remainingQuantity is int\n          && request.resource.data.remainingQuantity >= 0\n          && request.resource.data.remainingQuantity <= request.resource.data.totalQuantity\n          && request.resource.data.quantity == request.resource.data.remainingQuantity\n          && request.resource.data.status in ['active', 'pending'])\n        || (signedIn()\n          && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['remainingQuantity', 'quantity', 'lastRedemptionId'])\n          && request.resource.data.remainingQuantity == resource.data.remainingQuantity - 1\n          && request.resource.data.quantity == request.resource.data.remainingQuantity\n          && request.resource.data.lastRedemptionId is string\n          && existsAfter(/databases/$(database)/documents/couponRedemptions/$(request.resource.data.lastRedemptionId))\n          && getAfter(/databases/$(database)/documents/couponRedemptions/$(request.resource.data.lastRedemptionId)).data.couponId == couponId\n          && getAfter(/databases/$(database)/documents/couponRedemptions/$(request.resource.data.lastRedemptionId)).data.cost == resource.data.pointsCost\n          && resource.data.status == 'active' && resource.data.remainingQuantity > 0);\n      allow delete: if isAdmin();\n    }\n\n    match /submissions/{submissionId} {\n      allow read: if signedIn() && (isAdmin() || resource.data.userId == request.auth.uid);\n      allow create: if signedIn()\n        && request.resource.data.userId == request.auth.uid\n        && request.resource.data.userEmail == request.auth.token.email\n        && request.resource.data.bottles is int\n        && request.resource.data.bottles >= 1 && request.resource.data.bottles <= 1000\n        && request.resource.data.approvedBottles == 0 && request.resource.data.points == 0 && request.resource.data.money == 0\n        && request.resource.data.photoURL is string && request.resource.data.photoURL.size() <= 716800\n        && request.resource.data.photoURL.matches('data:image/jpeg;base64,[A-Za-z0-9+/=]+')\n        && request.resource.data.status == 'pending' && request.resource.data.createdAt == request.time\n        && request.resource.data.approvedAt == null && request.resource.data.rejectedAt == null\n        && request.resource.data.keys().hasOnly(['userId', 'userEmail', 'bottles', 'approvedBottles', 'points', 'money', 'photoURL', 'status', 'createdAt', 'approvedAt', 'rejectedAt']);\n      allow update: if isAdmin() && resource.data.status == 'pending'\n        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['status', 'approvedBottles', 'points', 'money', 'approvedAt', 'rejectedAt'])\n        && ((request.resource.data.status == 'approved'\n            && request.resource.data.approvedBottles is int\n            && request.resource.data.approvedBottles >= 1\n            && request.resource.data.approvedBottles <= resource.data.bottles\n            && request.resource.data.points == request.resource.data.approvedBottles * 5\n            && request.resource.data.money == request.resource.data.approvedBottles * 0.5\n            && request.resource.data.approvedAt == request.time && request.resource.data.rejectedAt == null)\n          || (request.resource.data.status == 'rejected' && request.resource.data.approvedBottles == 0\n            && request.resource.data.points == 0 && request.resource.data.money == 0\n            && request.resource.data.approvedAt == null && request.resource.data.rejectedAt == request.time));\n      allow delete: if isAdmin();\n    }\n\n    match /couponRedemptions/{redemptionId} {\n      allow read: if signedIn() && (isAdmin() || resource.data.userId == request.auth.uid);\n      allow create: if signedIn()\n        && request.resource.data.status == 'redeemed'\n        && request.resource.data.userId == request.auth.uid\n        && request.resource.data.userEmail == request.auth.token.email\n        && request.resource.data.couponId is string && request.resource.data.coupon is string\n        && redemptionId == request.auth.uid + '_' + request.resource.data.couponId\n        && request.resource.data.couponDescription is string\n        && request.resource.data.cost is int && request.resource.data.createdAt == request.time\n        && request.resource.data.approvedAt == null && request.resource.data.rejectedAt == null\n        && request.resource.data.keys().hasOnly(['userId', 'userEmail', 'couponId', 'coupon', 'couponDescription', 'cost', 'status', 'createdAt', 'approvedAt', 'rejectedAt'])\n        && validCouponRedemption(redemptionId, request.resource.data.couponId, request.resource.data.cost, request.auth.uid);\n      allow update: if isAdmin() && resource.data.status == 'pending'\n        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['status', 'approvedAt', 'rejectedAt'])\n        && ((request.resource.data.status == 'approved' && request.resource.data.approvedAt == request.time && request.resource.data.rejectedAt == null)\n          || (request.resource.data.status == 'rejected' && request.resource.data.approvedAt == null && request.resource.data.rejectedAt == request.time));\n      allow delete: if isAdmin();\n    }\n  }\n}\n","name":"firestore.rules"}]},"createTime":"2026-10-20T11:45:49.465903Z","metadata":{"services":["cloud.firestore"]}}
