rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() { return request.auth != null; }
    function isAdmin() {
      return signedIn()
        && exists(/databases/$(database)/documents/admins/$(request.auth.uid))
        && get(/databases/$(database)/documents/admins/$(request.auth.uid)).data.role == 'admin';
    }
    function validBottleAward(userId, submissionId) {
      let submission = getAfter(/databases/$(database)/documents/submissions/$(submissionId)).data;
      let userAfter = getAfter(/databases/$(database)/documents/users/$(userId)).data;
      let history = getAfter(/databases/$(database)/documents/users/$(userId)/history/$(submissionId)).data;
      return submission.userId == userId
        && submission.status == 'approved'
        && submission.approvedBottles is int
        && submission.approvedBottles >= 1
        && submission.points == submission.approvedBottles * 2
        && userAfter.bottles == resource.data.bottles + submission.approvedBottles
        && userAfter.points == resource.data.points + submission.points
        && userAfter.money == resource.data.get('money', 0) + submission.approvedBottles * 30 / 100
        && history.submissionId == submissionId
        && history.bottles == submission.approvedBottles
        && history.points == submission.points
        && history.money == submission.money;
    }
    function validBottleHistory(userId, submissionId) {
      let submission = getAfter(/databases/$(database)/documents/submissions/$(submissionId)).data;
      let userBefore = get(/databases/$(database)/documents/users/$(userId)).data;
      let userAfter = getAfter(/databases/$(database)/documents/users/$(userId)).data;
      return submission.userId == userId
        && submission.status == 'approved'
        && submission.approvedBottles is int
        && submission.points == submission.approvedBottles * 2
        && request.resource.data.submissionId == submissionId
        && request.resource.data.bottles == submission.approvedBottles
        && request.resource.data.points == submission.points
        && userAfter.bottles == userBefore.bottles + submission.approvedBottles
        && userAfter.points == userBefore.points + submission.points;
    }
    function validSubmissionApproval(userId, submissionId) {
      let submission = getAfter(/databases/$(database)/documents/submissions/$(submissionId)).data;
      let userBefore = get(/databases/$(database)/documents/users/$(userId)).data;
      let userAfter = getAfter(/databases/$(database)/documents/users/$(userId)).data;
      let history = getAfter(/databases/$(database)/documents/users/$(userId)/history/$(submissionId)).data;
      return submission.userId == userId
        && submission.status == 'approved'
        && submission.approvedBottles is int
        && submission.points == submission.approvedBottles * 2
        && userAfter.bottles == userBefore.bottles + submission.approvedBottles
        && userAfter.points == userBefore.points + submission.points
        && userAfter.money == userBefore.get('money', 0) + submission.approvedBottles * 30 / 100
        && history.submissionId == submissionId
        && history.bottles == submission.approvedBottles
        && history.points == submission.points
        && history.money == submission.money;
    }
    function validCouponRedemption(redemptionId, couponId, cost, userId) {
      let couponBefore = get(/databases/$(database)/documents/coupons/$(couponId)).data;
      let couponAfter = getAfter(/databases/$(database)/documents/coupons/$(couponId)).data;
      let userBefore = get(/databases/$(database)/documents/users/$(userId)).data;
      let userAfter = getAfter(/databases/$(database)/documents/users/$(userId)).data;
      return couponBefore.status == 'active'
        && couponBefore.remainingQuantity > 0
        && couponBefore.pointsCost == cost
        && couponAfter.remainingQuantity == couponBefore.remainingQuantity - 1
        && couponAfter.quantity == couponAfter.remainingQuantity
        && couponAfter.lastRedemptionId == redemptionId
        && userBefore.points >= cost
        && userAfter.points == userBefore.points - cost
        && userAfter.lastCouponRedemptionId == redemptionId;
    }

    match /admins/{adminId} {
      allow get: if signedIn() && request.auth.uid == adminId;
      allow list, create, update, delete: if false;
    }

    match /users/{userId} {
      allow read: if signedIn() && (request.auth.uid == userId || isAdmin());
      allow create: if signedIn()
        && request.auth.uid == userId
        && request.resource.data.uid == userId
        && request.resource.data.bottles == 0
        && request.resource.data.points == 0
        && request.resource.data.money == 0
        && request.resource.data.keys().hasOnly([
          'uid', 'username', 'email', 'bottles', 'points', 'money', 'createdAt'
        ]);
      allow update: if (isAdmin()
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['bottles', 'points', 'money', 'lastBottleSubmissionId'])
          && request.resource.data.lastBottleSubmissionId is string
          && validBottleAward(userId, request.resource.data.lastBottleSubmissionId))
        || (isAdmin()
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['bottles', 'points', 'money', 'university', 'dormType'])
          && request.resource.data.bottles == 0
          && request.resource.data.points == 0
          && request.resource.data.money == 0)
        || (signedIn() && request.auth.uid == userId
          && ((request.resource.data.diff(resource.data).affectedKeys().hasOnly(['university', 'dormType'])
              && request.resource.data.university is string
              && request.resource.data.university.size() > 0
              && ((request.resource.data.university == 'มหาวิทยาลัยธรรมศาสตร์'
                  && request.resource.data.dormType in ['หอใน', 'หอนอก', 'บ้าน'])
                || (request.resource.data.university != 'มหาวิทยาลัยธรรมศาสตร์'
                  && request.resource.data.dormType == null)))
            || (request.resource.data.diff(resource.data).affectedKeys().hasOnly(['points', 'lastCouponRedemptionId'])
              && request.resource.data.points is int
              && request.resource.data.points >= 0
              && request.resource.data.points < resource.data.points
              && request.resource.data.lastCouponRedemptionId is string
              && !exists(/databases/$(database)/documents/couponRedemptions/$(request.resource.data.lastCouponRedemptionId))
              && existsAfter(/databases/$(database)/documents/couponRedemptions/$(request.resource.data.lastCouponRedemptionId))
              && getAfter(/databases/$(database)/documents/couponRedemptions/$(request.resource.data.lastCouponRedemptionId)).data.userId == userId
              && getAfter(/databases/$(database)/documents/couponRedemptions/$(request.resource.data.lastCouponRedemptionId)).data.cost == resource.data.points - request.resource.data.points)));
      allow delete: if isAdmin();

      match /history/{historyId} {
        allow read: if signedIn() && (request.auth.uid == userId || isAdmin());
        allow create: if isAdmin() && validBottleHistory(userId, historyId);
        allow update: if false;
        allow delete: if isAdmin();
      }
      match /couponHistory/{redemptionId} {
        allow read: if signedIn() && (request.auth.uid == userId || isAdmin());
        allow create, update, delete: if false;
      }
    }

    match /coupons/{couponId} {
      allow read: if signedIn();
      allow create: if isAdmin()
        && request.resource.data.id == couponId
        && request.resource.data.pointsCost is int && request.resource.data.pointsCost > 0
        && request.resource.data.totalQuantity is int && request.resource.data.totalQuantity >= 0
        && request.resource.data.remainingQuantity is int
        && request.resource.data.remainingQuantity >= 0
        && request.resource.data.remainingQuantity <= request.resource.data.totalQuantity
        && request.resource.data.quantity == request.resource.data.remainingQuantity
        && request.resource.data.status in ['active', 'pending']
        && request.resource.data.keys().hasOnly(['id', 'name', 'description', 'pointsCost', 'totalQuantity', 'remainingQuantity', 'quantity', 'status', 'icon']);
      allow update: if (isAdmin()
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly([
            'pointsCost', 'totalQuantity', 'remainingQuantity', 'quantity', 'status'
          ])
          && request.resource.data.pointsCost is int && request.resource.data.pointsCost > 0
          && request.resource.data.totalQuantity is int && request.resource.data.totalQuantity >= 0
          && request.resource.data.remainingQuantity is int
          && request.resource.data.remainingQuantity >= 0
          && request.resource.data.remainingQuantity <= request.resource.data.totalQuantity
          && request.resource.data.quantity == request.resource.data.remainingQuantity
          && request.resource.data.status in ['active', 'pending'])
        || (signedIn()
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['remainingQuantity', 'quantity', 'lastRedemptionId'])
          && request.resource.data.remainingQuantity == resource.data.remainingQuantity - 1
          && request.resource.data.quantity == request.resource.data.remainingQuantity
          && request.resource.data.lastRedemptionId is string
          && !exists(/databases/$(database)/documents/couponRedemptions/$(request.resource.data.lastRedemptionId))
          && existsAfter(/databases/$(database)/documents/couponRedemptions/$(request.resource.data.lastRedemptionId))
          && getAfter(/databases/$(database)/documents/couponRedemptions/$(request.resource.data.lastRedemptionId)).data.userId == request.auth.uid
          && getAfter(/databases/$(database)/documents/couponRedemptions/$(request.resource.data.lastRedemptionId)).data.couponId == couponId
          && getAfter(/databases/$(database)/documents/couponRedemptions/$(request.resource.data.lastRedemptionId)).data.cost == resource.data.pointsCost
          && resource.data.status == 'active' && resource.data.remainingQuantity > 0);
      allow delete: if isAdmin();
    }

    match /submissions/{submissionId} {
      allow read: if signedIn() && (isAdmin() || resource.data.userId == request.auth.uid);
      allow create: if signedIn()
        && request.resource.data.userId == request.auth.uid
        && request.resource.data.userEmail == request.auth.token.email
        && request.resource.data.bottles is int
        && request.resource.data.bottles >= 1 && request.resource.data.bottles <= 1000
        && request.resource.data.approvedBottles == 0 && request.resource.data.points == 0 && request.resource.data.money == 0
        && request.resource.data.photoURL is string && request.resource.data.photoURL.size() <= 716800
        && request.resource.data.photoURL.matches('data:image/jpeg;base64,[A-Za-z0-9+/=]+')
        && request.resource.data.status == 'pending' && request.resource.data.createdAt == request.time
        && request.resource.data.approvedAt == null && request.resource.data.rejectedAt == null
        && request.resource.data.keys().hasOnly(['userId', 'userEmail', 'bottles', 'approvedBottles', 'points', 'money', 'photoURL', 'status', 'createdAt', 'approvedAt', 'rejectedAt']);
      allow update: if isAdmin() && resource.data.status == 'pending'
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['status', 'approvedBottles', 'points', 'money', 'approvedAt', 'rejectedAt'])
        && ((request.resource.data.status == 'approved'
            && request.resource.data.approvedBottles is int
            && request.resource.data.approvedBottles >= 1
            && request.resource.data.approvedBottles <= resource.data.bottles
            && request.resource.data.points == request.resource.data.approvedBottles * 2
            && request.resource.data.money == request.resource.data.approvedBottles * 30 / 100
            && request.resource.data.approvedAt == request.time && request.resource.data.rejectedAt == null
            && validSubmissionApproval(resource.data.userId, submissionId))
          || (request.resource.data.status == 'rejected' && request.resource.data.approvedBottles == 0
            && request.resource.data.points == 0 && request.resource.data.money == 0
            && request.resource.data.approvedAt == null && request.resource.data.rejectedAt == request.time));
      allow delete: if isAdmin();
    }

    match /couponRedemptions/{redemptionId} {
      allow read: if signedIn() && (isAdmin() || resource.data.userId == request.auth.uid);
      allow create: if signedIn()
        && request.resource.data.status == 'available'
        && request.resource.data.userId == request.auth.uid
        && request.resource.data.userEmail == request.auth.token.email
        && request.resource.data.couponId is string && request.resource.data.coupon is string
        && redemptionId != ''
        && request.resource.data.couponDescription is string
        && request.resource.data.cost is int && request.resource.data.createdAt == request.time
        && request.resource.data.usedAt == null
        && request.resource.data.approvedAt == null && request.resource.data.rejectedAt == null
        && request.resource.data.keys().hasOnly(['userId', 'userEmail', 'couponId', 'coupon', 'couponDescription', 'cost', 'status', 'createdAt', 'usedAt', 'approvedAt', 'rejectedAt'])
        && !exists(/databases/$(database)/documents/couponRedemptions/$(redemptionId))
        && validCouponRedemption(redemptionId, request.resource.data.couponId, request.resource.data.cost, request.auth.uid);
      allow update: if (isAdmin() && resource.data.status == 'pending'
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['status', 'approvedAt', 'rejectedAt'])
          && ((request.resource.data.status == 'approved' && request.resource.data.approvedAt == request.time && request.resource.data.rejectedAt == null)
            || (request.resource.data.status == 'rejected' && request.resource.data.approvedAt == null && request.resource.data.rejectedAt == request.time)))
        || (signedIn() && resource.data.userId == request.auth.uid
          && resource.data.status == 'redeemed'
          && request.resource.data.status == 'available'
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['status']))
        || (signedIn() && resource.data.userId == request.auth.uid
          && resource.data.status == 'available'
          && request.resource.data.status == 'used'
          && request.resource.data.usedAt == request.time
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['status', 'usedAt']));
      allow delete: if false;
    }
  }
}
